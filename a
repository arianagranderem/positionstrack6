local function AttachRideConstraint(petModel)
    local character = LocalPlayer.Character
    if not character or not character.PrimaryPart then return false end

    local ridePos = petModel:FindFirstChild("RidePosition", true)
    if not ridePos then return false end

    local sourceAttach = Instance.new("Attachment")
    sourceAttach.Parent = ridePos
    sourceAttach.Position = Vector3.new(0, 1.237, 0)
    sourceAttach.Name = "SourceAttachment"

    local rigidConstraint = Instance.new("RigidConstraint")
    rigidConstraint.Name = "StateConnection"
    rigidConstraint.Attachment0 = sourceAttach
    rigidConstraint.Attachment1 = character.PrimaryPart.RootAttachment
    rigidConstraint.Parent = character

    return true
end

local function DismountPet()
    if not CurrentRideId then return end

    local pet = SpawnedPets[CurrentRideId]
    if pet and pet.model then
        if RideAnimationTrack then
            RideAnimationTrack:Stop()
            RideAnimationTrack:Destroy()
            RideAnimationTrack = nil
        end

        local sourceAttach = pet.model:FindFirstChild("SourceAttachment", true)
        if sourceAttach then sourceAttach:Destroy() end

        local character = LocalPlayer.Character
        if character then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part:GetAttribute("HaveMass") then
                    part.Massless = false
                end
            end
        end

        ClearPetStates(CurrentRideId)
        ClearPlayerStates()
        pet.model:ScaleTo(1)
    end
    CurrentRideId = nil
end

local function MountPet(petUniqueId, playerState, petState)
    local pet = SpawnedPets[petUniqueId]
    if not pet or not pet.model then return end

    local character = LocalPlayer.Character
    if not character or not character.PrimaryPart or not character:FindFirstChild("Humanoid") then return end

    DismountPet()
    CurrentRideId = petUniqueId

    SetPetState(petUniqueId, petState)
    SetPlayerState(playerState)
    pet.model:ScaleTo(2)
    AttachRideConstraint(pet.model)

    RideAnimationTrack = character.Humanoid.Animator:LoadAnimation(AnimationManager.get_track("PlayerRidingPet"))
    character.Humanoid.Sit = true

    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.Massless == false then
            part.Massless = true
            part:SetAttribute("HaveMass", true)
        end
    end

    RideAnimationTrack:Play()
end

local function RidePet(petUniqueId)
    MountPet(petUniqueId, "PlayerRidingPet", "PetBeingRidden")
end

local function FlyPet(petUniqueId)
    MountPet(petUniqueId, "PlayerFlyingPet", "PetBeingFlown")
end

local function UnequipPet(petData)
    local pet = SpawnedPets[petData.unique]
    if not pet or not pet.model then return end

    if CurrentRideId == petData.unique then
        DismountPet()
    end

    RemovePetWrapper(petData.unique)
    RemovePetState(petData.unique)
    -- Remove from PetEntityManager and CharWrapperClient patch
    if PetEntityManager then
        pcall(function() PetEntityManager.remove_pet_entity_by_char(pet.model) end)
    end
    if CharWrapperClient._spawned_wrappers then
        CharWrapperClient._spawned_wrappers[pet.model] = nil
    end
    -- Remove name tag
    pcall(function()
        UIManager.apps.PlayerNameApp:remove_npc_id(pet.model)
    end)
    pet.model:Destroy()
    pet.model = nil

    if EquippedPet and EquippedPet.unique == petData.unique then
        EquippedPet = nil
    end

    PetAilmentsCache[petData.unique] = nil

    -- Remove from equip_manager so BackpackApp shows Equip again
    pcall(function()
        local identity = get_thread_identity and get_thread_identity() or 8
        set_thread_identity(2)
        local equipManager = ClientData.get("equip_manager") or {}
        local prev = table.clone(equipManager)
        local updated = table.clone(equipManager)
        updated.pets = updated.pets or {}
        local newPets = {}
        for _, v in ipairs(updated.pets) do
            if v.unique ~= petData.unique then
                table.insert(newPets, v)
            end
        end
        updated.pets = newPets
        ClientData.predict("equip_manager", updated)
        pcall(function()
            ClientData._trigger_server_on_change("equip_manager", updated, prev)
        end)
        set_thread_identity(identity)
    end)

    task.wait(0.15)
    pcall(function()
        AilmentsClient.on_ailments_changed(LocalPlayer)
    end)
    task.defer(function()
        if UIManager and UIManager.apps then
            pcall(function()
                if UIManager.apps.BackpackApp then
                    UIManager.apps.BackpackApp:refresh_rendered_items()
                end
            end)
        end
    end)
end

local function EquipPet(petData)
    if petData.category ~= "pets" then return end

    if EquippedPet then
        UnequipPet(EquippedPet)
    end

    pcall(function()
        for _, wrapper in pairs(ClientData.get("pet_char_wrappers") or {}) do
            if wrapper and wrapper.controller == LocalPlayer then
                RouterClient.get("ToolAPI/Unequip"):InvokeServer(wrapper.pet_unique)
            end
        end
    end)

    if not SpawnedPets[petData.unique] then
        SpawnedPets[petData.unique] = { data = petData, model = nil }
    end

    local petModel = FetchPetModel(petData.kind):Clone()
    petModel.Parent = workspace
    SpawnedPets[petData.unique].model = petModel
    ApplyNeonVisuals(petModel, petData)

    EquippedPet = petData

    -- Add name tag via PlayerNameApp (same as NPCProxyPetEntity)
    task.defer(function()
        pcall(function()
            local kindData = KindDB[petData.id]
            if kindData then
                -- Use rp_name if set, otherwise use kind name
                local rpName = petData.properties.rp_name
                local displayName = (rpName and rpName ~= "") and ("(%s)"):format(rpName) or kindData.name
                UIManager.apps.PlayerNameApp:add_npc_id(petModel, displayName, {
                    pet_kind = petData.kind,
                })
            end
        end)
    end)

    -- Register with PetEntityManager so overhead UI renders (name, friendship bar, ailments)
    task.spawn(function()
        task.wait(0.5) -- wait for wrapper to be registered via ClientData
        if PetEntityManager then
            pcall(function()
                local kindData = KindDB[petData.id]
                if kindData and not PetEntityManager.get_pet_entity(petModel) then
                    -- Build wrapper object that CharWrapperClient.get() will return
                    local wrapperObj = {
                        char = petModel,
                        pet_model = petModel:FindFirstChild("PetModel") or petModel,
                        mega_neon = petData.properties.mega_neon or false,
                        neon = petData.properties.neon or false,
                        flyable = petData.properties.flyable or false,
                        rideable = petData.properties.rideable or false,
                        player = LocalPlayer,
                        entity_controller = LocalPlayer,
                        client_has_control = true,
                        rp_name = petData.properties.rp_name or "",
                        pet_trick_level = petData.properties.pet_trick_level or 0,
                        pet_unique = petData.unique,
                        pet_id = petData.id,
                        is_pet = true,
                        location = {
                            full_destination_id = "housing",
                            destination_id = "housing",
                            house_owner = LocalPlayer
                        },
                        pet_progression = {
                            age = petData.properties.age or 6,
                            percentage = 0,
                            friendship_level = petData.properties.friendship_level or 0
                        },
                    }
                    -- Patch CharWrapperClient.get to return our wrapper for this model
                    -- Only patch once, then build a lookup table
                    if not CharWrapperClient._spawned_wrappers then
                        CharWrapperClient._spawned_wrappers = {}
                        local originalGet = CharWrapperClient.get
                        CharWrapperClient.get = function(char)
                            if CharWrapperClient._spawned_wrappers[char] then
                                return CharWrapperClient._spawned_wrappers[char]
                            end
                            return originalGet(char)
                        end
                    end
                    CharWrapperClient._spawned_wrappers[petModel] = wrapperObj

                    local function entityCallback(entity)
                        entity.base.char = petModel
                        entity.base.char_wrapper = wrapperObj
                        entity.base.pet_model = wrapperObj.pet_model
                        entity.base.humanoid = petModel:FindFirstChildOfClass("Humanoid")
                        entity.base.root = petModel:FindFirstChild("HumanoidRootPart")
                        -- Force entity_controller INSIDE the callback before the entity is finalized
                        wrapperObj.entity_controller = LocalPlayer
                        wrapperObj.player = LocalPlayer
                        wrapperObj.client_has_control = true
                    end
                    local entity = PetEntityManager.create_pet_entity(petModel, kindData, entityCallback)
                    -- Also force after creation in case something overwrote it
                    if entity then
                        if entity.base.char_wrapper then
                            entity.base.char_wrapper.entity_controller = LocalPlayer
                            entity.base.char_wrapper.client_has_control = true
                        end
                        -- Manually add to local owned list if not already there
                        local owned = PetEntityManager.get_local_owned_pet_entities()
                        if not table.find(owned, entity) then
                            table.insert(owned, entity)
                            PetEntityManager.get_local_owned_pet_entity_updated_signal():Fire(owned, entity)
                        end
                    end
                end
            end)
        end
    end)

    -- Inject into equip_manager so BackpackApp sees the pet as equipped
    pcall(function()
        local identity = get_thread_identity and get_thread_identity() or 8
        set_thread_identity(2)
        local equipManager = ClientData.get("equip_manager") or {}
        local prev = table.clone(equipManager)
        local updated = table.clone(equipManager)
        updated.pets = updated.pets or {}
        local newPets = {}
        for _, v in ipairs(updated.pets) do
            if v.unique ~= petData.unique then
                table.insert(newPets, v)
            end
        end
        table.insert(newPets, petData)
        updated.pets = newPets
        ClientData.predict("equip_manager", updated)
        -- Trigger the server_on_change_hook so BackpackApp re-renders
        pcall(function()
            ClientData._trigger_server_on_change("equip_manager", updated, prev)
        end)
        set_thread_identity(identity)
    end)

    -- Refresh backpack UI so Equip button updates to Unequip
    task.defer(function()
        if UIManager and UIManager.apps then
            pcall(function()
                if UIManager.apps.BackpackApp then
                    UIManager.apps.BackpackApp:refresh_rendered_items()
                end
            end)
