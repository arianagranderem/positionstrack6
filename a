        for wearId, _ in pairs(selectedWearIds) do
            local wid = wearId
            task.spawn(function()
                ApplyPetWear(petData.unique, wid)
            end)
            task.wait(0.15)
        end
    end)

    task.defer(function()
        RegisterPetWrapper({
            char = petModel,
            mega_neon = petData.properties.mega_neon or false,
            neon = petData.properties.neon or false,
            flyable = petData.properties.flyable or false,
            rideable = petData.properties.rideable or false,
            player = LocalPlayer,
            entity_controller = LocalPlayer,
            controller = LocalPlayer,
            client_has_control = true,
